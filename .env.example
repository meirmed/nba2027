# Firebase web config (client). Create a NEW Firebase project for NBA 2027.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=me-west1
# "true" to talk to local emulators
VITE_USE_EMULATORS=false
# Live-score API key is NOT here: it goes to Secret Manager (firebase functions:secrets:set NBA_API_KEY)
