rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = custom claim only. users.isAdmin is display-only and never trusted.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Games manager: a normal player who may also choose the games (claim set by the admin). Limited to games that have NOT started.
    function isGameManager() { return signedIn() && request.auth.token.gameManager == true; }
    function gameNotStarted() { return resource.data.status in ['scheduled', 'cancelled'] && resource.data.tipoff > request.time; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Profile: owner may edit ONLY these fields. paid / blocked / isAdmin / email are admin-or-function only.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if false;                       // created by function (Phase 1)
      allow update: if isAdmin() || (isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username','phone','team','photoURL','lang','updatedAt'])); // NOT name: only the admin renames a player
      allow delete: if isAdmin();
    }

    // Participant whitelist (admin adds names BEFORE people can register). Claimed via callable only.
    match /participants/{id} {
      allow read, write: if isAdmin();
    }

    // Player list for bonus questions (admin-maintained).
    match /players/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Reference / config data: signed-in read, admin write.
    match /teams/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /games/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      // GAMES MANAGER: add a future game (scheduled, no score), change / cancel / delete a game that has not started. Never a score, a result or the API link.
      allow create: if isGameManager()
        && request.resource.data.status == 'scheduled' && request.resource.data.tipoff > request.time
        && request.resource.data.get('s1', null) == null && request.resource.data.get('s2', null) == null
        && request.resource.data.get('ot', 0) == 0 && request.resource.data.get('winner', null) == null
        && request.resource.data.get('overridden', false) == false;
      allow update: if isGameManager() && gameNotStarted()
        && request.resource.data.status in ['scheduled', 'cancelled'] && request.resource.data.tipoff > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t1', 't2', 'tipoff', 'venue', 'status', 'round', 'seriesKey', 'seriesId', 'gameNum', 'updatedAt']);
      allow delete: if isGameManager() && gameNotStarted();
    }
    match /bonus/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /appSettings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /h2hTournament/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /h2h/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }

    // Everyone's bonus answers, published when a question closes (deadline passed or correct answer set). Written by functions only.
    match /bonusPicks/{id} { allow read: if signedIn(); allow write: if false; }

    // Named lists of players / coaches for the "player" bonus questions (admin only; players only need players/{id}.listIds).
    match /playerLists/{id} { allow read, write: if isAdmin(); }

    // Public snapshot of picks, written by function at tip-off.
    match /picks/{gameId} { allow read: if signedIn(); allow write: if false; }

    // Points are written by Cloud Functions only (admin overrides go through a callable -> auditLog).
    match /points/{uid} { allow read: if signedIn(); allow write: if false; }

    // PREDICTIONS: private until lock. Client writes go through callable `savePredictions`
    // (validates tip-off server-side, scores 0-200 ints, writes dotted paths + serverTimestamp).
    // Rules cannot loop over map keys to check each game's tip-off, so direct client writes are denied.
    match /predictions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Per-game points + picks of FINISHED games (written by functions only). Readable by every signed-in player: those picks are public
    // after tip-off anyway. Upcoming picks are NOT in here (they stay in predictions/{uid}, owner/admin only).
    match /pointsDetail/{uid} { allow read: if signedIn(); allow write: if false; }

    // Manual point adjustments (written by functions only). ADMIN-ONLY: the reason is never exposed to players (they see only the total in points/{uid}.adjust).
    match /adjustments/{id} { allow read: if isAdmin(); allow write: if false; }

    // App errors reported by players' devices: any signed-in user may CREATE a small report about themselves; only admins read / clear them.
    match /clientErrors/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','message','stack','context','route','ua','ts'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.ts == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Public, function-written summaries (e.g. the star of the night).
    match /stats/{id} { allow read: if signedIn(); allow write: if false; }

    // Poller heartbeat (written by pollLiveScores only)
    match /system/{id} { allow read: if isAdmin(); allow write: if false; }

    // The games manager may write ONLY his own game.* entries (his actions are logged under his name).
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (isGameManager() && request.resource.data.by == request.auth.uid && request.resource.data.action.matches('game\\..*'));
      allow update, delete: if false;
    }
    match /backups/{id}  { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
